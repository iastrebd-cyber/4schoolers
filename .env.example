# Supabase — значения берутся в дашборде Supabase (Project Settings → API).
# Реальные значения класть в .env (он в .gitignore и в репозиторий не попадает).
# Внимание: ключи с префиксом VITE_ попадают в браузерный бандл — здесь только
# anon/publishable key. service_role-ключ НИКОГДА не кладём во фронт/в .env с VITE_.

SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
